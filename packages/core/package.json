{
	"name": "@pi-cordis/core",
	"version": "0.2.0",
	"description": "Cordis microkernel control plane and native plugin harness for Pi Coding Agent",
	"type": "module",
	"piConfig": {
		"name": "picds",
		"configDir": ".picds"
	},
	"bin": {
		"picds": "dist/cli.js",
		"picordis": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
