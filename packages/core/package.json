{
	"name": "@pi-cordis/core",
	"version": "0.2.0",
	"description": "Cordis microkernel control plane and native plugin harness for Pi Coding Agent",
	"type": "module",
	"piConfig": {
		"name": "picds",
		"configDir": ".picds"
	},
	"bin": {
		"picds": "./src/cli.ts",
		"picordis": "./src/cli.ts"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"scripts": {
		"build": "tsc --noEmit",
		"test": "vitest --run"
	},
	"dependencies": {
		"@deepseek-ai/cordis": "^4.0.1",
		"@deepseek-ai/cosmokit": "^1.8.2",
		"@deepseek-ai/schemastery": "^3.18.1",
		"@pi-cordis/profiles": "workspace:*",
		"@pi-cordis/plugin-btw": "workspace:*",
		"@pi-cordis/plugin-terminal-notifier": "workspace:*",
		"@earendil-works/pi-coding-agent": "^0.84.2",
		"@earendil-works/pi-agent-core": "^0.84.2",
		"@earendil-works/pi-ai": "^0.84.2",
		"@earendil-works/pi-client": "^0.84.2",
		"@earendil-works/pi-protocol": "^0.84.2",
		"@earendil-works/pi-tui": "^0.84.2",
		"chalk": "^5.4.1",
		"yaml": "^2.7.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
