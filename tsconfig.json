{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": ["./*"],
			"@deepseek-ai/cordis": ["./vendor/cordis/src/index.ts"],
			"@deepseek-ai/cordis/*": ["./vendor/cordis/src/*"],
			"@deepseek-ai/cosmokit": ["./vendor/cosmokit/src/index.ts"],
			"@deepseek-ai/cosmokit/*": ["./vendor/cosmokit/src/*"],
			"@deepseek-ai/schemastery": ["./vendor/schemastery/src/index.ts"],
			"@deepseek-ai/schemastery/*": ["./vendor/schemastery/src/*"],
			"@earendil-works/pi-coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@earendil-works/pi-coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@earendil-works/pi-coding-agent/*": ["./packages/coding-agent/src/*"]
		}
	},
	"include": [
		"packages/coding-agent/src/**/*",
		"packages/coding-agent/test/**/*",
		"vendor/*/src/**/*"
	],
	"exclude": [
		"**/dist/**",
		"**/lib/**"
	]
}
