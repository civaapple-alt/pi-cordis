{
	"name": "@pi-cordis/profiles",
	"version": "0.1.0",
	"description": "Profile and preset composition hub for Pi-Cordis",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist", "README.md", "README.zh.md"],
	"scripts": {
